---
import Layout from '../layouts/Layout.astro';
import Pricing from '../components/Pricing.astro';
import Gallery from '../components/Gallery.astro';
import CoreSection from '../components/CoreSection.astro';
---

<Layout title="TrimmOS - El Núcleo Digital para tu Negocio">
    <!-- BOTÓN FLOTANTE DE WHATSAPP -->
    <a 
        href="https://wa.me/528135731273?text=Hola%2C%20vengo%20de%20la%20p%C3%A1gina%20web.%20Quiero%20activar%20mi%20mes%20gratis%20de%20TrimmOS%20para%20mi%20negocio" 
        target="_blank" 
        class="fixed bottom-8 right-8 z-50 flex items-center justify-center w-16 h-16 bg-[#25D366] rounded-full shadow-[0_0_20px_rgba(37,211,102,0.4)] hover:scale-110 transition-transform group"
    >
        <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="absolute right-full mr-4 bg-white text-black text-[10px] font-bold py-2 px-4 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap shadow-xl uppercase tracking-wider">
            ¡Obtén 30 días gratis!
        </span>
    </a>

    <!-- HERO SECTION -->
    <main class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#070709]">
        <div class="absolute -top-1/4 -left-1/4 w-[600px] h-[600px] bg-purple-600 rounded-full mix-blend-lighten filter blur-[120px] opacity-20"></div>
        <div class="absolute -bottom-1/4 -right-1/4 w-[600px] h-[600px] bg-blue-600 rounded-full mix-blend-lighten filter blur-[120px] opacity-20"></div>

        <!-- Logo de fondo del hero -->
        <div class="absolute inset-0 flex items-center justify-center z-0 pointer-events-none">
            <img src="/trimmos-logo.png" alt="" class="w-3/4 md:w-1/2 opacity-20 md:opacity-10 object-contain mix-blend-screen filter blur-[0.5px]" />
        </div>

        <div class="relative z-10 text-center px-4 max-w-5xl">
            <h1 class="text-6xl md:text-8xl font-extrabold tracking-tighter mb-6 italic text-white">
                Trimm<span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">OS</span>
            </h1>
            <h2 class="text-4xl md:text-6xl font-bold mb-8 leading-tight text-white min-h-[120px] md:min-h-[auto]">
                Domina tu Negocio con <br/> 
                <span id="dynamic-text" class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 font-light italic transition-all duration-500 inline-block">
                    Identidad y Control Absoluto
                </span>
            </h2>
            <p class="text-lg md:text-xl text-gray-400 mb-10 leading-relaxed max-w-3xl mx-auto">
                TrimmOS combina agenda inteligente, administración de staff, clientes y servicios con reportes completos y personalización de marca. <strong>Todo en un mismo sistema pensado para barberías y salones.</strong>
            </p>
            
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
                <div class="relative group">

                  <!-- Core y su globo de diálogo -->
                    <div
                        class="pointer-events-none absolute -left-20 top-1/2 z-30
                            -translate-y-1/2 translate-x-5 scale-90 opacity-0
                            transition-all duration-300 ease-out
                            group-hover:translate-x-0
                            group-hover:scale-100
                            group-hover:opacity-100"
                    >
                        <!-- Globo colocado respecto a Core -->
                        <div
                            class="absolute bottom-full left-0 mb-2
                                whitespace-nowrap rounded-xl
                                border border-purple-500/70
                                bg-[#1a1a1f]
                                px-3 py-2
                                text-xs text-white
                                shadow-[0_0_24px_rgba(147,51,234,0.25)]"
                        >
                            ¿Listo? Empecemos gratis.

                            <!-- Punta del globo -->
                            <span
                                class="absolute -bottom-2 left-8
                                    h-4 w-4 rotate-45
                                    border-b border-r border-purple-500/70
                                    bg-[#1a1a1f]"
                            ></span>
                        </div>

                        <!-- Imagen de Core -->
                        <img
                            src="/core-mini.png"
                            alt="Core invitando a comenzar gratis"
                            class="w-28 h-auto object-contain"
                        />
                    </div> 

                    <!-- Botón principal -->
                    <a
                        href="#pricing"
                        class="relative z-20 block
                            rounded-2xl bg-purple-600
                            px-10 py-4
                            font-bold text-white
                            shadow-[0_0_20px_rgba(147,51,234,0.3)]
                            transition-all duration-300
                            hover:scale-105 hover:bg-purple-700"
                    >
                        Empezar mi Mes Gratis
                    </a>

                </div>

                <a
                    href="#demo"
                    class="bg-[#16161a] border border-gray-800 hover:border-gray-600 text-white px-10 py-4 rounded-2xl font-bold transition-all"
                >
                    Ver Personalización
                </a>
            </div>
        </div>
    </main>

    <!-- SECCIÓN DE PERSONALIZACIÓN VISUAL -->
    <Gallery />

    <!-- FEATURES SECTION -->
    <section id="features" class="py-20 bg-[#070709]">
        <div class="max-w-6xl mx-auto px-4">
            <div class="text-center mb-16">
                <h2 class="text-4xl md:text-5xl font-extrabold text-white mb-4 italic tracking-tighter">Lo que trae TrimmOS</h2>
                <p class="text-gray-400 max-w-2xl mx-auto leading-relaxed">
                    Un sistema completo para tu barbería o salón con agenda, equipo, clientes, ventas y branding desde el primer día.
                </p>
            </div>

            <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
                <div class="p-8 rounded-3xl bg-[#16161a] border border-gray-800">
                    <h3 class="text-2xl font-bold mb-4 text-white">Panel administrativo diario</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Supervisa tu operación diaria con métricas clave, control rápido y una vista clara de lo más importante.
                    </p>
                </div>
                <div class="p-8 rounded-3xl bg-[#16161a] border border-gray-800">
                    <h3 class="text-2xl font-bold mb-4 text-white">Gestión de staff</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Coordina turnos, horarios y personal fácilmente para que tu equipo trabaje sincronizado y sin confusiones.
                    </p>
                </div>
                <div class="p-8 rounded-3xl bg-[#16161a] border border-gray-800">
                    <h3 class="text-2xl font-bold mb-4 text-white">Agenda digital</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Reserva, reprograma y controla citas con una agenda diseñada para el ritmo real de barberías y salones.
                    </p>
                </div>
                <div class="p-8 rounded-3xl bg-[#16161a] border border-gray-800">
                    <h3 class="text-2xl font-bold mb-4 text-white">Reportes y personalización</h3>
                    <p class="text-gray-400 text-sm leading-relaxed">
                        Extrae reportes diarios, semanales, mensuales y anuales en PDF o Excel, y personaliza logo y colores para tus clientes.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECCIÓN DE CORE --> 

    <CoreSection />
    
    <Pricing />

    <!-- FOOTER -->
    <footer class="py-16 border-t border-gray-900 bg-[#070709] text-center">
        <div class="max-w-6xl mx-auto px-4">
            <div class="mb-8 flex flex-col items-center gap-4">
                <div class="flex items-center justify-center gap-3">
                    <div class="w-14 h-14 rounded-full overflow-hidden bg-[#070709] border border-white/10 flex items-center justify-center shadow-[0_0_24px_rgba(0,0,0,0.35)]">
                        <img src="/logoHC.jpng.png" alt="Hesed Core" class="w-full h-full object-contain rounded-full" />
                    </div>
                    <h3 class="text-2xl font-black text-white tracking-[0.15em] italic uppercase">
                        HESED<span class="text-purple-600">CORE</span>
                    </h3>
                </div>
                <p class="text-gray-600 text-[10px] uppercase tracking-[0.4em] mt-2">Engineering with Purpose</p>
            </div>
            <div class="mb-8 flex flex-col items-center gap-3">
                <p class="text-gray-400 text-sm uppercase tracking-[0.2em]">Síguenos en</p>
                <div class="flex items-center justify-center gap-3">
                    <a href="https://www.facebook.com/hesedcore" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" aria-label="Facebook">
                        <img src="/facebook.png?v=2" alt="Facebook" class="w-5 h-5 object-contain" />
                    </a>
                    <a href="https://www.instagram.com/hesedcore?igsh=Nmluc2JmcWlzaW8%3D&utm_source=qr" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" aria-label="Instagram">
                        <img src="/instagram.png?v=2" alt="Instagram" class="w-5 h-5 object-contain" />
                    </a>
                    <a href="https://x.com/hesedcore?s=11" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" aria-label="X">
                        <img src="/gorjeo.png?v=2" alt="X" class="w-5 h-5 object-contain" />
                    </a>
                    <a href="https://www.tiktok.com/@hesed.core?_r=1&_t=ZS-9785JRMXyzd" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" aria-label="TikTok">
                        <img src="/tik-tok.png?v=2" alt="TikTok" class="w-5 h-5 object-contain" />
                    </a>
                    <a href="https://www.youtube.com/@TrimmOSOficial" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-white/10 flex items-center justify-center hover:bg-white/20 transition-colors" aria-label="YouTube">
                        <img src="/youtube.png?v=2" alt="YouTube" class="w-5 h-5 object-contain" />
                    </a>
                </div>
            </div>
            <p class="text-gray-500 text-xs">
                &copy; 2026 TrimmOS. Desarrollado con ⚡ en García, NL.
            </p>
        </div>
    </footer>
</Layout>

<script is:inline>
    const phrases = [
        "Identidad y Control Absoluto",
        "Gestión Inteligente de Citas",
        "Automatización de Staff",
        "Reportes en Tiempo Real",
        "Tu Marca, Tus Reglas"
    ];
    
    let currentIndex = 0;
    const textElement = document.getElementById('dynamic-text');

    function changeText() {
        if (!textElement) return;
        
        // Animación de salida
        textElement.style.opacity = '0';
        textElement.style.transform = 'translateY(10px)';

        setTimeout(() => {
            currentIndex = (currentIndex + 1) % phrases.length;
            textElement.textContent = phrases[currentIndex];
            
            // Animación de entrada
            textElement.style.opacity = '1';
            textElement.style.transform = 'translateY(0)';
        }, 500);
    }

    setInterval(changeText, 3500);
</script>